{
  "name": "@new-cms/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CMSのCLI（スキーマのデプロイ、カスタムノードの雛形、既存のブログからの取り込み）",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "cms": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@new-cms/editor-schema": "0.1.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "exports": {
    "./types": {
      "types": "./types/index.d.ts"
    }
  }
}
