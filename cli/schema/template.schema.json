{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "yomotsuhirasaka template",
  "description": "テンプレートのファイル（templates/<テンプレート名>/template.json）。本文のノードとマークは書かない（CLIが、管理画面と同じTiptapの拡張機能から書き出す）。",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "このファイルのJSON Schemaの場所（エディタが使う。CMSは読まない）。",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "locales": {
      "description": "コンテンツのロケール（例: `ja`, `en`）。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultLocale": {
      "description": "既定のロケール（`locales` のどれか）。",
      "type": "string"
    },
    "body": {
      "$ref": "#/$defs/TemplateBody"
    },
    "contentTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContentType"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "locales",
    "defaultLocale",
    "contentTypes"
  ],
  "$defs": {
    "TemplateBody": {
      "description": "テンプレートのファイルの本文の設定（ノードとマークはCLIが書き出す）。",
      "type": "object",
      "properties": {
        "embedProviders": {
          "description": "埋め込みを許す提供元のホスト名（例: `www.youtube.com`）。https のURLだけを受け付ける（Q97）。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "customNodes": {
          "description": "カスタムノード。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CustomNode"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "CustomNode": {
      "description": "カスタムノード。テンプレートに宣言的に書き、Tiptapの拡張機能はこの宣言から作る（`@yomotsuhirasaka/editor-schema`）。\nMarkdownへの変換関数は必須（ないものはデプロイを拒否する。INV-NODE-01）。HTMLへの変換関数は任意で、\n出力は無害化する（INV-CNV-01）。変換関数は純粋な関数で、ホスト関数は使えない。",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "description": "編集者向けの説明（管理画面のカードに出す。Q51）。",
          "type": [
            "string",
            "null"
          ]
        },
        "inline": {
          "description": "インライン（段落などの子）か。既定はブロック。",
          "type": "boolean",
          "default": false
        },
        "attrs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CustomAttr"
          },
          "default": []
        },
        "children": {
          "description": "子として許すノード。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "toMarkdown": {
          "description": "`toMarkdown(node, ctx)` を既定のエクスポートにするESモジュール。",
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "toHtml": {
          "description": "`toHtml(node, ctx)` を既定のエクスポートにするESモジュール。",
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateScript"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "CustomAttr": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/AttrType"
        },
        "description": {
          "description": "編集者向けの説明（管理画面の入力欄に出す。Q51）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "AttrType": {
      "description": "カスタムノードの属性の型。",
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean"
      ]
    },
    "TemplateScript": {
      "description": "テンプレートのファイルでの関数: TSのファイルへのパス（テンプレートのフォルダからの相対パス。フォルダの外は指せない）。\nCLIが esbuild で1つのESモジュールにまとめ、マニフェストの `source` にする。",
      "type": "object",
      "properties": {
        "file": {
          "description": "TSのファイル（例: `./functions/url.ts`）。既定のエクスポートが関数本体。",
          "type": "string"
        },
        "permissions": {
          "description": "呼べるホスト関数。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "default": []
        },
        "allowedHosts": {
          "description": "`http.fetch` で送ってよいホスト名かIPアドレス。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "description": "`secrets.read` で読む秘密の名前。",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "file"
      ]
    },
    "Permission": {
      "description": "関数が権限として宣言できるホスト関数（04-hooks.md「外部へのアクセス」）。",
      "oneOf": [
        {
          "description": "同じワークスペースの公開中の記事を読む（`yomi.content.get(id)`）。",
          "type": "string",
          "const": "content.read"
        },
        {
          "description": "外部へHTTPで送る（`yomi.http.fetch(url, options)`）。非同期のフックだけ。宛先は `allowedHosts` に限る。",
          "type": "string",
          "const": "http.fetch"
        },
        {
          "description": "ワークスペースに登録した秘密を読む（`yomi.secrets.get(name)`）。非同期のフックだけ。名前は `secrets` に宣言する。",
          "type": "string",
          "const": "secrets.read"
        }
      ]
    },
    "ContentType": {
      "description": "関数の書き方（型の引数）: マニフェストではJSのソース（[`crate::script::Script`]）、\nテンプレートのファイルではTSのファイルへのパス（[`TemplateScript`]。CLIがJSにしてマニフェストに入れる。Q49）。",
      "type": "object",
      "properties": {
        "name": {
          "description": "コンテンツタイプの名前（英小文字で始まる英小文字・数字・`_`）。DBとGraphQLの名前の元になる。",
          "type": "string"
        },
        "urlTemplate": {
          "description": "ロケールごとの公開URLのテンプレート。使える差し込みは `{locale}` と `{slug}`（Q82）。",
          "type": "string"
        },
        "urlFunction": {
          "description": "URL生成関数（M2、Q38）。あれば、テンプレートの代わりにこれで公開URLを作る。\n受け取るのは公開する記事（`{id, contentType, locale, slug, fields}`）、返すのは http(s) の絶対URL。",
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "hooks": {
          "description": "フック（M2、04-hooks.md）。",
          "$ref": "#/$defs/Hooks"
        },
        "titleField": {
          "description": "記事のタイトルのフィールド（text）。訂正フィード・目録・管理画面の一覧などで記事の名前として使う。",
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "description": "確認期限（06-corrections-and-freshness.md「鮮度」）。なければ期限なし。記事ごとに上書きできる。",
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ]
        },
        "aiMarkdown": {
          "description": "AI向けのMarkdown版に載せるもの（M2、07-ai-delivery.md、Q35）。挙げていないフィールドは載せない。\nなければ、このタイプの記事はAI向けの素材（Markdown版・目録）にならない。",
          "anyOf": [
            {
              "$ref": "#/$defs/AiMarkdown"
            },
            {
              "type": "null"
            }
          ]
        },
        "listLimit": {
          "description": "一覧のフィールドで1回に取得できる件数の上限。",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "description": {
          "description": "編集者向けの説明（管理画面に表示する。Q51）。",
          "type": [
            "string",
            "null"
          ]
        },
        "devNote": {
          "description": "開発者向けのメモ。どのAPIにも出さない（Q51、INV-SCH-01）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "urlTemplate",
        "listLimit",
        "fields"
      ]
    },
    "Hooks": {
      "description": "コンテンツタイプのフック（04-hooks.md、Q12）。種類ごとに1つ。\n\n- 同期（結果を待つ。外部と通信できない）:\n  - `beforeSave`: 下書きの保存の前。受け取るのは `{entry: {id, contentType, locale, fields}}`、返すのは直すフィールド\n    `{fields: {...}}`。保存は止めない（失敗したら直さずに保存し、知らせる）。\n  - `beforePublish`: 公開の前。受け取るのは同じ形、返すのは公開を止める理由 `{errors: [{field?, message}]}`。\n    失敗したときも公開を止める。\n- 非同期（後からジョブで動く。失敗したらやり直す）。受け取るのは `{event, entry}`、返した値は使わない:\n  - `afterSave`: 保存が30秒止まってから、記事ごとに1回（その時点の下書き）。\n  - `afterPublish`: 公開・更新・訂正としての公開の後（公開した版）。\n  - `afterUnpublish`: 非公開・削除の後（entry は null）。",
      "type": "object",
      "properties": {
        "beforeSave": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "beforePublish": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterSave": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterPublish": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateScript"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterUnpublish": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateScript"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Review": {
      "description": "確認期限の既定値。",
      "type": "object",
      "properties": {
        "intervalDays": {
          "description": "最終確認日からの日数（1〜3650）。",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "intervalDays"
      ]
    },
    "AiMarkdown": {
      "description": "AI向けのMarkdown版の中身（07-ai-delivery.md）。CMSは、ここに挙げたものに加えて、URL・ロケール・更新日・最終確認日・\n読了時間・訂正履歴・削除済みアンカーを冒頭のメタデータに載せる。",
      "type": "object",
      "properties": {
        "title": {
          "description": "見出し（`#`）にするフィールド（text）。目録の記事の名前にも使う。",
          "type": "string"
        },
        "meta": {
          "description": "冒頭のメタデータ（front matter）に載せるフィールド（text・slug）。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "fields": {
          "description": "本文として、この順に載せるフィールド（text・richtext）。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "relations": {
          "description": "関係として載せる参照フィールド。関係の種類はフィールドの名前、相手は記事のURL。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "name": {
          "description": "フィールドの名前（英小文字で始まる英小文字・数字・`_`）。DBとGraphQLの名前の元になる。",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/FieldType"
        },
        "required": {
          "description": "公開に必須か（スラッグは常に必須）。",
          "type": "boolean",
          "default": false
        },
        "referenceTo": {
          "description": "参照フィールドの参照先のコンテンツタイプ。",
          "type": [
            "string",
            "null"
          ]
        },
        "multiple": {
          "description": "複数の値を持つか（参照フィールドだけ）。",
          "type": "boolean",
          "default": false
        },
        "description": {
          "description": "編集者向けの説明（Q51）。",
          "type": [
            "string",
            "null"
          ]
        },
        "devNote": {
          "description": "開発者向けのメモ。どのAPIにも出さない（Q51、INV-SCH-01）。",
          "type": [
            "string",
            "null"
          ]
        },
        "searchable": {
          "description": "検索・質問応答の対象か（M3、08-search-and-related.md「対象の制御」、Q16）。既定は対象外。\n使えるのは text と richtext だけ。対象でないフィールドの内容は、検索用データにも検索結果にも入れない（INV-SRC-03）。",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "FieldType": {
      "description": "フィールドの型（M1）。",
      "oneOf": [
        {
          "description": "1行の文字列。",
          "type": "string",
          "const": "text"
        },
        {
          "description": "URLに使う文字列（英小文字・数字・ハイフン）。",
          "type": "string",
          "const": "slug"
        },
        {
          "description": "本文（Tiptapの構造化JSON）。",
          "type": "string",
          "const": "richtext"
        },
        {
          "description": "他の記事への参照（翻訳グループを指す。Q157）。",
          "type": "string",
          "const": "reference"
        }
      ]
    }
  }
}
