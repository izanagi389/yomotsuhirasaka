{
  "$schema": "../../cli/schema/template.schema.json",
  "locales": ["ja", "en"],
  "defaultLocale": "ja",
  "body": {
    "embedProviders": ["www.youtube.com", "www.youtube-nocookie.com"]
  },
  "contentTypes": [
    {
      "name": "post",
      "description": "ブログの記事",
      "urlTemplate": "https://example.com/{locale}/blog/{slug}",
      "listLimit": 50,
      "aiMarkdown": { "title": "title", "meta": ["summary"], "fields": ["body"], "relations": ["related"] },
      "fields": [
        { "name": "title", "type": "text", "required": true, "description": "記事のタイトル" },
        { "name": "slug", "type": "slug", "required": true, "description": "URLに使う名前（英小文字・数字・ハイフン）" },
        { "name": "summary", "type": "text", "description": "一覧や検索結果に出す短い説明" },
        { "name": "body", "type": "richtext", "required": true },
        { "name": "related", "type": "reference", "referenceTo": "post", "multiple": true, "description": "関連する記事" }
      ]
    }
  ]
}
